{
  "name": "goclaude",
  "version": "1.0.0",
  "description": "Run Claude Code inside a gondolin micro-VM sandbox",
  "private": true,
  "type": "module",
  "bin": {
    "goclaude": "./goclaude.mjs"
  },
  "scripts": {
    "build": "./build-image.sh",
    "build:alpine": "./build-image.sh --alpine",
    "build:docker": "./build-image.sh --docker",
    "start": "node ./goclaude.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "@earendil-works/gondolin": "^0.14.0"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  }
}
